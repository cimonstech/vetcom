# Supabase — create a project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 — media uploads (server-only except public URL)
# Dashboard: R2 → Manage R2 API Tokens + bucket settings
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Public base URL for objects (custom domain or r2.dev public URL)
# Example: https://media.vetcomcommunication.com  or  https://pub-xxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-public-r2-url
